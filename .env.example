# Existing PostgreSQL database. Use a pooled connection URL if your host requires it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Required: there is no built-in production password. Never expose this with NEXT_PUBLIC_.
ADMIN_PASSWORD=replace-with-a-long-random-password
# Request email notification via Resend. Keep all values server-only.
ADMIN_EMAIL=admin@example.com
RESEND_API_KEY=re_replace_with_server_side_key
RESEND_FROM_EMAIL="Vault <requests@your-verified-domain.example>"
# Optional contact spam limits (PostgreSQL-backed, shared across app instances).
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
CONTACT_RATE_LIMIT_MAX_ATTEMPTS=5
CONTACT_RATE_LIMIT_GLOBAL_MAX_ATTEMPTS=100
# Optional separate HMAC key for contact limiter counters; otherwise ADMIN_PASSWORD is used.
# CONTACT_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Anonymous comment sessions use HttpOnly signed cookies; defaults to ADMIN_PASSWORD.
# Set independent random server-only keys for production rotation/isolation if desired.
# COMMENT_SESSION_SECRET=replace-with-a-long-random-secret
# COMMENT_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
COMMENT_RATE_LIMIT_WINDOW_SECONDS=600
COMMENT_RATE_LIMIT_MAX_ATTEMPTS=10
COMMENT_RATE_LIMIT_CLIENT_MAX_ATTEMPTS=40

# Cloudflare R2: server-only S3 API credentials scoped to the media bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-bucket
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
# Optional upload/download tuning. Videos upload directly from the browser to R2.
R2_MAX_VIDEO_BYTES=10737418240
R2_MAX_IMAGE_BYTES=10485760
R2_PART_SIZE_BYTES=16777216
R2_DOWNLOAD_URL_TTL_SECONDS=3600
R2_UPLOAD_URL_TTL_SECONDS=21600

# Optional production database pool size (default 10).
# DATABASE_POOL_MAX=10

# Optional canonical public origin. Set this behind a TLS-terminating proxy so
# browser mutation requests are checked against the public origin, not an internal host.
# APP_ORIGIN=https://your-site.example

# Admin login rate limits (PostgreSQL-backed, shared across app instances).
# Forwarded IP headers are IGNORED unless you name one header that your trusted
# proxy overwrites with a single client IP (for example x-real-ip or cf-connecting-ip).
# Without a trusted header, all login attempts share the global bucket.
# ADMIN_LOGIN_TRUSTED_IP_HEADER=
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_GLOBAL_MAX_ATTEMPTS=30
