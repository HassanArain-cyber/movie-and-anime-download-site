# Existing PostgreSQL database. Use a pooled connection URL if your host requires it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Required: there is no built-in production password. Never expose this with NEXT_PUBLIC_.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Cloudflare R2: server-only S3 API credentials scoped to the media bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-bucket
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
# Optional upload/download tuning. Videos upload directly from the browser to R2.
R2_MAX_VIDEO_BYTES=10737418240
R2_MAX_IMAGE_BYTES=10485760
R2_PART_SIZE_BYTES=16777216
R2_DOWNLOAD_URL_TTL_SECONDS=3600
R2_UPLOAD_URL_TTL_SECONDS=21600

# Optional production database pool size (default 10).
# DATABASE_POOL_MAX=10
